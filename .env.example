# Telegram
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Admins: comma-separated Telegram user IDs
ADMIN_IDS=

# Rubika
RUBIKA_BOT_TOKEN=

# Bale
BALE_BOT_TOKEN=

# Railway/public webhook
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN
PORT=8080

# Persistent database. Leave empty on Railway so RAILWAY_VOLUME_MOUNT_PATH is used.
DB_PATH=
RAILWAY_VOLUME_MOUNT_PATH=

# Manual partner top-up/payment information
PAYMENT_CARD=
PAYMENT_CARD_OWNER=

# SizPay automatic payment gateway
# کد پذیرنده از پنل سیزپی
SIZPAY_MERCHANT_ID=
# کد ترمینال
SIZPAY_TERMINAL_ID=
# کلید 1 / نام کاربری
SIZPAY_USERNAME=
# کلید 2 / رمز
SIZPAY_PASSWORD=
# کلید امضا (اگر سیزپی برای پذیرنده مقدار جداگانه داده است؛ در غیر این صورت خالی)
SIZPAY_SIGN_DATA=
SIZPAY_SOAP_URL=https://rt.sizpay.ir/KimiaIPGRouteService.asmx
SIZPAY_PAYMENT_URL=https://rt.sizpay.ir/Route/Payment

# Variza automatic card-to-card payment
VARIZA_API_KEY=
VARIZA_WEBHOOK_SECRET=
VARIZA_RETURN_URL=
VARIZA_PAYMENT_EXPIRES=2h

# Legacy/static service payment fallback (used only when Variza API is not configured)
SERVICE_PAYMENT_URL=

# Optional first partner provisioning
INITIAL_PARTNER_PHONE=
INITIAL_PARTNER_PASSWORD=

# Optional Telegram webhook secret
TELEGRAM_WEBHOOK_SECRET=

# Native Windows Desktop Agent (keep secret; never commit the real value)
DESKTOP_AGENT_KEY=
